        ],
        "lineageTag": "d61546b2-d7d4-4cf5-a943-f64a5ef2f769",
        "measures": [
          {
            "name": "Chiffre d’affaires",
            "description": "Somme des montants de vente ; devise non précisée par la source.",
            "displayFolder": "Ventes",
            "expression": "SUM(Ventes[Montant vente])",
            "formatString": "#,0.00",
            "lineageTag": "598248f2-b6a1-494c-abe6-f6bebd4288ab"
          },
          {
            "name": "Commandes",
            "description": "Nombre de commandes distinctes.",
            "displayFolder": "Ventes",
            "expression": "DISTINCTCOUNT(Ventes[Numéro commande])",
            "formatString": "#,0",
            "lineageTag": "241f99fe-f2ba-439b-9129-0923a200e5af"
          },
          {
            "name": "Unités vendues",
            "description": "Somme des quantités vendues.",
            "displayFolder": "Ventes",
            "expression": "SUM(Ventes[Quantité])",
            "formatString": "#,0",
            "lineageTag": "375bed7c-5cbf-4155-a030-e1965be44ef2"
          },
          {
            "name": "Clients actifs",
            "description": "Clients ayant au moins une vente dans le contexte sélectionné.",
            "displayFolder": "Clients",
            "expression": "DISTINCTCOUNT(Ventes[Clé client])",
            "formatString": "#,0",
            "lineageTag": "fd2a82dc-5265-4f34-ae8d-c075e4bb846d"
          },
          {
            "name": "Produits vendus",
            "description": "Produits avec au moins une vente dans le contexte sélectionné.",
            "displayFolder": "Produits",
            "expression": "DISTINCTCOUNT(Ventes[Clé produit])",
            "formatString": "#,0",
            "lineageTag": "1bb2035b-1b76-4c07-8d42-21362b107d29"
          },
          {
            "name": "Panier moyen",
            "description": "Chiffre d’affaires par commande distincte.",
            "displayFolder": "Ventes",
            "expression": "DIVIDE([Chiffre d’affaires], [Commandes])",
            "formatString": "#,0.00",
            "lineageTag": "57bd8088-a83f-468a-9f2c-68211f437e5e"
          },
          {
            "name": "CA année précédente",
            "description": "CA sur les dates équivalentes de l’année précédente.",
            "displayFolder": "Évolution",
            "expression": "CALCULATE([Chiffre d’affaires], SAMEPERIODLASTYEAR(Calendrier[Date]))",
            "formatString": "#,0.00",
            "lineageTag": "7db18fe4-9ae6-4111-b42a-764f4b08932b"
          },
          {
            "name": "Évolution CA %",
            "description": "Variation annuelle affichée uniquement lorsque les deux années sont comprises entre les années de début et de fin de couverture. Le total multiannuel reste vide.",
            "displayFolder": "Évolution",
            "expression": [
              "VAR Annee = SELECTEDVALUE(Calendrier[Année])",
              "VAR PremiereDate = CALCULATE(MIN(Ventes[Date commande]), REMOVEFILTERS())",
              "VAR DerniereDate = CALCULATE(MAX(Ventes[Date commande]), REMOVEFILTERS())",
              "RETURN IF(NOT ISBLANK(Annee) && Annee > YEAR(PremiereDate) + 1 && Annee < YEAR(DerniereDate), DIVIDE([Chiffre d’affaires] - [CA année précédente], [CA année précédente]), BLANK())"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "64146fe1-1416-435a-a6ab-0b82044e1fcd"
          },
          {
            "name": "CA cumulé annuel",
            "description": "Cumul depuis le début de l’année dans le contexte courant.",
            "displayFolder": "Évolution",
            "expression": "TOTALYTD([Chiffre d’affaires], Calendrier[Date])",
            "formatString": "#,0.00",
            "lineageTag": "38166eb4-a5b8-488a-82b7-273a662a9605"
          },
          {
            "name": "Commandes par client",
            "description": "Fréquence de commande dans la période sélectionnée.",
            "displayFolder": "Clients",
            "expression": "DIVIDE([Commandes], [Clients actifs])",
            "formatString": "0.00",
            "lineageTag": "73cb3aaa-789e-4d2e-b8bf-7245b14dd524"
          },
          {
            "name": "Clients récurrents",
            "description": "Clients avec plus d’une commande dans la période sélectionnée.",
            "displayFolder": "Clients",
            "expression": "COUNTROWS(FILTER(VALUES(Ventes[Clé client]), CALCULATE([Commandes]) > 1))",
            "formatString": "#,0",
            "lineageTag": "b42114f0-c150-4a82-ae20-57290a588e2f"
          },
          {
            "name": "Taux de récurrence",
            "description": "Proportion des clients actifs avec plusieurs commandes dans la période sélectionnée.",
            "displayFolder": "Clients",
            "expression": "DIVIDE([Clients récurrents], [Clients actifs])",
            "formatString": "0.0%",
            "lineageTag": "1cce0ccd-bb25-474f-a5f9-c97708887462"
          },
          {
            "name": "CA par client",
            "description": "Chiffre d’affaires moyen par client actif.",
            "displayFolder": "Clients",
            "expression": "DIVIDE([Chiffre d’affaires], [Clients actifs])",
            "formatString": "#,0.00",
            "lineageTag": "527e32cb-8b41-48b8-914e-fee19edb3ef0"
          },
          {
            "name": "CA expédié",
            "description": "CA analysé selon la date d’expédition.",
            "displayFolder": "Ventes",
            "expression": "CALCULATE([Chiffre d’affaires], USERELATIONSHIP(Calendrier[Date], Ventes[Date expédition]))",
            "formatString": "#,0.00",
            "lineageTag": "c0fd7bda-b533-4bbd-a0ee-ca4cc753318d"
          },
          {
            "name": "Lignes sans date",
            "description": "Lignes sans date de commande, hors filtre calendrier.",
            "displayFolder": "Qualité",
            "expression": "CALCULATE(COUNTROWS(Ventes), REMOVEFILTERS(Calendrier), ISBLANK(Ventes[Date commande]))",
            "formatString": "#,0"
          },
          {
            "name": "CA sans date",
            "description": "CA inclus dans le total mais non attribuable à une période.",
            "displayFolder": "Qualité",
            "expression": "CALCULATE([Chiffre d’affaires], REMOVEFILTERS(Calendrier), ISBLANK(Ventes[Date commande]))",
            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "Ventes",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\\SQLEXPRESS\", \"DataWeareHouse\"),",
                "    Gold = Source{[Schema=\"gold\", Item=\"fact_sales\"]}[Data],",
                "    Renomme = Table.RenameColumns(Gold, {{\"order_number\", \"Numéro commande\"}, {\"produt_key\", \"Clé produit\"}, {\"customer_key\", \"Clé client\"}, {\"order_date\", \"Date commande\"}, {\"shipping_date\", \"Date expédition\"}, {\"due_date\", \"Date échéance\"}, {\"sales_amount\", \"Montant vente\"}, {\"quantity\", \"Quantité\"}, {\"price\", \"Prix unitaire\"}})",
                "in",
                "    Renomme"
              ],
              "type": "m"
            }
          }
        ]
      },
