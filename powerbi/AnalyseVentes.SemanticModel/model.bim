        "dataCategory": "Time",
        "lineageTag": "3b29d1f9-6a96-4f32-95f0-0be748afe847",
        "partitions": [
          {
            "name": "Calendrier",
            "mode": "import",
            "source": {
              "expression": [
                "VAR Debut = MIN(Ventes[Date commande])",
                "VAR Fin = MAX(Ventes[Date commande])",
                "RETURN ADDCOLUMNS(CALENDAR(DATE(YEAR(Debut),1,1),DATE(YEAR(Fin),12,31)), \"Année\", YEAR([Date]), \"Mois numéro\", MONTH([Date]), \"Mois\", FORMAT([Date],\"mmmm\",\"fr-FR\"), \"Année-mois\", FORMAT([Date],\"yyyy-MM\"), \"Tri année-mois\", YEAR([Date])*100+MONTH([Date]), \"Trimestre\", \"T\" & FORMAT([Date],\"Q\"))"
              ],
              "type": "calculated"
            }
          }
        ]
      }
    ]
