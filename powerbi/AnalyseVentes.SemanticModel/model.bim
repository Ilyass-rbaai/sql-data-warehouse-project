        "lineageTag": "513460a1-f266-4fb8-8ff0-bbf73e8d33a4",
        "partitions": [
          {
            "name": "Clients",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\\SQLEXPRESS\", \"DataWeareHouse\"),",
                "    Gold = Source{[Schema=\"gold\", Item=\"dim_customers\"]}[Data],",
                "    Renomme = Table.RenameColumns(Gold, {{\"customer_key\", \"Clé client\"}, {\"customer_id\", \"Identifiant client\"}, {\"customer_number\", \"Numéro client\"}, {\"first_name\", \"Prénom\"}, {\"last_name\", \"Nom\"}, {\"country\", \"Pays\"}, {\"marital_status\", \"Situation familiale\"}, {\"gender\", \"Genre\"}, {\"birthdate\", \"Date de naissance\"}, {\"create_date\", \"Date de création\"}}),",
                "    Enrichi = Table.AddColumn(Renomme, \"Client\", each Text.Trim(Text.Combine({[Prénom], [Nom]}, \" \")), type text),",
                "    PaysFrancais = Table.TransformColumns(Enrichi, {{\"Pays\", each if _ = \"Germany\" then \"Allemagne\" else if _ = \"United States\" then \"États-Unis\" else if _ = \"United Kingdom\" then \"Royaume-Uni\" else if _ = \"France\" then \"France\" else if _ = \"Australia\" then \"Australie\" else if _ = \"Canada\" then \"Canada\" else if _ = null or _ = \"n/a\" or _ = \"\" then \"Non renseigné\" else _, type text}})",
                "in",
                "    PaysFrancais"
              ],
              "type": "m"
            }
          }
        ]
      },
