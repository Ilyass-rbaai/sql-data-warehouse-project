        "partitions": [
          {
            "name": "Produits",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\\SQLEXPRESS\", \"DataWeareHouse\"),",
                "    Gold = Source{[Schema=\"gold\", Item=\"dim_products\"]}[Data],",
                "    Renomme = Table.RenameColumns(Gold, {{\"produt_key\", \"Clé produit\"}, {\"product_id\", \"Identifiant produit\"}, {\"product_number\", \"Numéro produit\"}, {\"product_name\", \"Produit\"}, {\"category_id\", \"Identifiant catégorie\"}, {\"category\", \"Catégorie\"}, {\"subcategory\", \"Sous-catégorie\"}, {\"maintenance\", \"Maintenance\"}, {\"prroduct_line\", \"Gamme\"}, {\"cost\", \"Coût actuel\"}, {\"start_date\", \"Date de début\"}}),",
                "    CategoriesFrancaises = Table.TransformColumns(Renomme, {{\"Catégorie\", each if _ = \"Bikes\" then \"Vélos\" else if _ = \"Accessories\" then \"Accessoires\" else if _ = \"Clothing\" then \"Vêtements\" else if _ = \"Components\" then \"Composants\" else if _ = null or _ = \"n/a\" then \"Non renseignée\" else _, type text}})",
                "in",
                "    CategoriesFrancaises"
              ],
              "type": "m"
            }
          }
        ]
      },
